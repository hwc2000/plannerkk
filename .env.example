# 서버에서만 사용하는 비밀 키입니다. VITE_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_PLAN_MODEL=gpt-4o-mini

# 프론트엔드와 API를 다른 출처에서 직접 실행할 때만 변경합니다.
FRONTEND_ORIGIN=http://localhost:5173

# 로그인/회원가입 (기본: 켜짐). 혼자 로컬에서만 쓸 때 off로 두면 예전처럼 로그인 없이 동작합니다.
REPLAN_AUTH=on
# HTTPS로 배포할 때 1로 설정하면 세션 쿠키에 Secure 속성이 붙습니다.
REPLAN_SECURE_COOKIES=0
